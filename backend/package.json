{
  "name": "it-budget-backend",
  "version": "1.0.0",
  "description": "IT Budget Backend",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "knex migrate:latest",
    "db:seed:mandatory": "knex seed:run --specific=002_mandatory_seed.js",
    "db:seed:optional": "knex seed:run --specific=003_optional_seed.js",
    "db:status": "knex migrate:status",
    "db:rollback": "knex migrate:rollback",
    "db:rollback:all": "knex migrate:rollback --all",
    "db:setup": "npm run db:migrate && npm run db:seed:mandatory",
    "db:reset": "node scripts/confirm-db-reset.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mssql": "^9.1.1",
    "knex": "^3.0.1",
    "passport": "^0.7.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  }
}
